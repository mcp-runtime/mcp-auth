# Local development only. Never put real credentials in this file.
MCP_AUTH_ISSUER=http://localhost:8080
MCP_AUTH_RESOURCES=http://localhost:8081/mcp
MCP_AUTH_LISTEN_ADDR=:8080
MCP_AUTH_ACCESS_TOKEN_TTL=10m
MCP_AUTH_REFRESH_TOKEN_TTL=24h
MCP_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Production should point at a secret-managed PEM file. Omit locally to generate ephemeral test keys.
MCP_AUTH_PRIVATE_KEY_FILE=
MCP_AUTH_STORE=sqlite
MCP_AUTH_DATABASE_URL=/var/lib/mcp-auth/mcp-auth.db
MCP_AUTH_CONNECTORS_FILE=/etc/mcp-auth/connectors.json
MCP_AUTH_CONNECTOR=
MCP_AUTH_ALLOW_INSECURE_CONNECTORS=false
