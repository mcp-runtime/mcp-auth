{
  "name": "@mcp-auth/client",
  "version": "0.4.0",
  "description": "Provider-neutral authorization helpers for MCP resource servers",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=22" },
  "keywords": ["mcp", "oauth", "jwt", "authorization"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agent-Hellboy/mcp-auth.git",
    "directory": "auth-client/typescript"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
