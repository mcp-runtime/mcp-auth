{
  "compose-oidc": {
    "issuer": "http://keycloak:8080/realms/mcp",
    "authorization_endpoint": "http://keycloak:8080/realms/mcp/protocol/openid-connect/auth",
    "token_endpoint": "http://keycloak:8080/realms/mcp/protocol/openid-connect/token",
    "jwks_uri": "http://keycloak:8080/realms/mcp/protocol/openid-connect/certs",
    "client_id": "mcp-auth",
    "client_secret_env": "KEYCLOAK_CLIENT_SECRET",
    "scopes": ["openid", "profile"],
    "exchange_client_id": "mcp-auth",
    "identity_claims": ["preferred_username"],
    "token_endpoint_auth_method": "client_secret_post",
    "allowed_upstream_callback_uris": ["http://mcp-auth:8080/identity/callback"],
    "downstream_token_strategy": "upstream_session"
  }
}
